<?xml version="1.0" encoding="utf-8"?>
<!--
  DM Sans — tipografia do redesign. Os TTFs são empacotados no APK
  (licença SIL Open Font License 1.1) para funcionar offline, sem depender
  do Google Play Services como os "downloadable fonts" exigiriam.

  Pesos: 400 regular, 500 medium, 700 bold, 800 extrabold.
  O textStyle="bold" dos layouts resolve para o peso 700.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/dm_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/dm_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/dm_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
    <font
        android:font="@font/dm_sans_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800" />
</font-family>
