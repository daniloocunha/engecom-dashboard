<?xml version="1.0" encoding="utf-8"?>
<!--
  Item do Histórico. A raiz é um LinearLayout para comportar o cabeçalho de dia
  ("Seg, 28 de Julho"), que o adapter exibe apenas no primeiro RDO de cada data —
  é o agrupamento por dia do redesign, sem precisar de um segundo view type.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvDayHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="9dp"
        android:textAppearance="@style/TextAppearance.CalculadoraHH.LabelCaps"
        tools:text="Seg, 28 de Julho" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRDO"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_default"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <!-- Cabeçalho: número + badge de status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNumeroRDO"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:textAppearance="@style/TextAppearance.CalculadoraHH.CardTitle"
                        tools:text="998070-28.07.26-001" />

                    <TextView
                        android:id="@+id/tvLocal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:textAppearance="@style/TextAppearance.CalculadoraHH.Detail"
                        tools:text="📍 Km 125+300" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvNumeroOS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.CalculadoraHH.Detail"
                            tools:text="OS: 98765" />

                        <TextView
                            android:id="@+id/tvStatusOS"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textAppearance="@style/TextAppearance.CalculadoraHH.Detail"
                            tools:text="· Em Andamento" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEncarregado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CalculadoraHH.Detail"
                        tools:text="👤 João Silva" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/badgeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_sync"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="3dp">

                    <ImageView
                        android:id="@+id/ivSyncStatus"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="Status de sincronização"
                        tools:src="@drawable/ic_check" />

                    <TextView
                        android:id="@+id/tvSyncStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        tools:text="SYNC"
                        tools:textColor="@color/green_sync" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="11dp"
                android:background="@color/border_default" />

            <!-- Ações -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnSyncIndividual"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Sincronizar este RDO"
                    android:padding="4dp"
                    android:src="@drawable/ic_sync"
                    app:tint="@color/amber_pending" />

                <ImageButton
                    android:id="@+id/btnEditar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Editar RDO"
                    android:padding="4dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/btnUsarModelo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Usar como modelo"
                    android:padding="4dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/btnEnviar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="14dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Compartilhar RDO"
                    android:padding="4dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/btnDeletar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Excluir RDO"
                    android:padding="4dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/red_delete" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
