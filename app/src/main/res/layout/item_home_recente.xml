<?xml version="1.0" encoding="utf-8"?>
<!-- Card de RDO recente na tela inicial -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="15dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_default"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRecenteNumero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.CalculadoraHH.CardTitle"
                tools:text="998070-28.07.26-001" />

            <TextView
                android:id="@+id/tvRecenteStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_sync"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="✓ SYNC"
                tools:textColor="@color/green_sync" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecenteDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.CalculadoraHH.Detail"
            tools:text="Km 125+300 · OS 98765 · João Silva" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
