<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Design tokens do redesign "Controle de Campo".

      Este arquivo tem os valores do TEMA CLARO; values-night/colors.xml
      sobrescreve os mesmos nomes com os valores do tema escuro (que é o
      padrão do app e o especificado pelo design).

      Regra: layouts e estilos devem usar SEMPRE os nomes semânticos
      (bg_*, text_*, border_*, gold_*, ...) ou atributos de tema
      (?attr/colorSurface). Nunca hex literal.
    -->

    <!-- ══════════ Marca (mesma matiz nos dois temas) ══════════ -->
    <color name="gold_primary">#E8C300</color>
    <color name="blue_accent">#3B82F6</color>
    <color name="green_sync">#22C55E</color>
    <color name="amber_pending">#F59E0B</color>
    <color name="purple_accent">#A855F7</color>
    <color name="red_delete">#EF4444</color>

    <!-- Preto da marca: texto sobre superfícies douradas nos dois temas -->
    <color name="on_gold">#0D0D0D</color>

    <!-- ══════════ Backgrounds (claro) ══════════ -->
    <color name="bg_primary">#FFFFFF</color>
    <color name="bg_surface">#F7F7F5</color>
    <color name="bg_card">#FFFFFF</color>
    <color name="bg_input">#FFFFFF</color>
    <color name="bg_nav">#FFFFFF</color>

    <!-- ══════════ Texto (claro) ══════════ -->
    <color name="text_primary">#111827</color>
    <color name="text_secondary">#4B5563</color>
    <color name="text_muted">#6B7280</color>
    <color name="text_dim">#9CA3AF</color>
    <color name="text_on_hero">#7A6600</color>

    <!-- ══════════ Bordas (claro) ══════════ -->
    <color name="border_default">#E5E7EB</color>
    <color name="border_input">#D1D5DB</color>

    <!--
      Dourado legível como TEXTO. No escuro o próprio #E8C300 tem contraste
      suficiente; no claro ele falha, então usamos um tom mais fechado.
    -->
    <color name="gold_text">#7A6600</color>

    <!-- ══════════ Superfícies tonais dos cards de ação (claro) ══════════ -->
    <color name="gold_dim">#FFFBE6</color>
    <color name="gold_dim_end">#FFF6CC</color>
    <color name="gold_surface">#FFFBEB</color>
    <color name="blue_dim">#EFF6FF</color>
    <color name="green_dim">#ECFDF5</color>
    <color name="purple_dim">#FAF5FF</color>

    <!-- Subtítulos dos cards de ação (claro) -->
    <color name="gold_sub">#8A7300</color>
    <color name="blue_sub">#1D4ED8</color>
    <color name="green_sub">#15803D</color>
    <color name="purple_sub">#7E22CE</color>

    <!-- ══════════ Alfas derivados (rgba do design → #AARRGGBB) ══════════ -->
    <color name="gold_a22">#38E8C300</color>
    <color name="gold_a18">#2EE8C300</color>
    <color name="gold_a15">#26E8C300</color>
    <color name="gold_a13">#21E8C300</color>
    <color name="blue_a18">#2E3B82F6</color>
    <color name="blue_a13">#213B82F6</color>
    <color name="green_a25">#4022C55E</color>
    <color name="green_a18">#2E22C55E</color>
    <color name="green_a11">#1C22C55E</color>
    <color name="green_a10">#1A22C55E</color>
    <color name="amber_a25">#40F59E0B</color>
    <color name="amber_a18">#2EF59E0B</color>
    <color name="amber_a14">#24F59E0B</color>
    <color name="amber_a10">#1AF59E0B</color>
    <color name="purple_a18">#2EA855F7</color>
    <color name="purple_a11">#1CA855F7</color>
    <color name="red_a20">#33EF4444</color>
    <color name="red_a10">#1AEF4444</color>

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!-- Compatibilidade: nomes Material3 antigos, remapeados para a     -->
