    <color name="md_theme_dark_background">#0D0D0D</color>
    <color name="md_theme_dark_onBackground">#F3F4F6</color>
    <color name="md_theme_dark_inverseSurface">#F3F4F6</color>
    <color name="md_theme_dark_inverseOnSurface">#111827</color>
</resources>
