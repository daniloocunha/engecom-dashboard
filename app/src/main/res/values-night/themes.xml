<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      O tema é definido uma única vez em values/themes.xml (DayNight) e as
      cores trocam por values-night/colors.xml. Aqui ficam apenas os ajustes
      que não são cor — os ícones das barras de sistema precisam ser claros
      no tema escuro.
    -->
    <style name="Theme.CalculadoraHH" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorOnPrimary">@color/on_gold</item>
        <item name="colorPrimaryContainer">@color/gold_surface</item>
        <item name="colorOnPrimaryContainer">@color/gold_text</item>

        <item name="colorSecondary">@color/blue_accent</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/blue_dim</item>
        <item name="colorOnSecondaryContainer">@color/blue_accent</item>

        <item name="colorTertiary">@color/green_sync</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">@color/green_dim</item>
        <item name="colorOnTertiaryContainer">@color/green_sync</item>

        <item name="colorError">@color/red_delete</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">@color/red_a10</item>
        <item name="colorOnErrorContainer">@color/red_delete</item>

        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/bg_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/bg_surface</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorOutline">@color/border_input</item>
        <item name="colorOutlineVariant">@color/border_default</item>

        <item name="colorSurfaceInverse">@color/md_theme_dark_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_dark_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/gold_primary</item>

        <!-- Ícones claros nas barras de sistema -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_nav</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <item name="fontFamily">@font/dm_sans</item>
        <item name="android:fontFamily">@font/dm_sans</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CalculadoraHH.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CalculadoraHH.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CalculadoraHH.LargeComponent</item>

        <item name="android:windowActivityTransitions">true</item>
    </style>
</resources>
